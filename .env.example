# Public Supabase project URL, for example https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public/publishable key. Safe to expose in the browser; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role key used exclusively by local seed/import scripts. Never expose or commit a value.
SUPABASE_SERVICE_ROLE_KEY=
# Absolute public application URL used for magic-link callbacks.
NEXT_PUBLIC_SITE_URL=
# Development seed identities. Supabase sends real magic links to these addresses; do not use real client data.
SEED_COACH_EMAIL=
SEED_CLIENT_ONE_EMAIL=
SEED_CLIENT_TWO_EMAIL=
# Server-only opt-in for dedicated E2E accounts. Keep disabled outside an
# active test window and never include passwords in application environment.
E2E_TEST_LOGIN_ENABLED=false
E2E_TEST_EMAILS=
# Provisioning script inputs. Keep these only in a local ignored env file or
# the CI secret store; they are not application runtime variables.
E2E_TEST_COACH_EMAIL=
E2E_TEST_COACH_PASSWORD=
E2E_TEST_CLIENT_EMAIL=
E2E_TEST_CLIENT_PASSWORD=
# Web Push. Generate a pair with `npm run push:vapid`; no Apple Developer or
# Firebase account is involved. The public half ships to the browser by design -
# a subscription is bound to it - and the private half signs every send, so
# losing it invalidates every subscription that already exists.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL the push service can use to reach whoever is sending.
# Required by RFC 8292; a push service may refuse a request without it.
VAPID_SUBJECT=
# Server-only secret the scheduler and the on-write drain authenticate with.
CRON_SECRET=
