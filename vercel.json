{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "main": true,
      "staging": true,
      "preview/*": true,
      "codex/ai-meal-analysis": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "30 18 * * *"
    }
  ]
}
