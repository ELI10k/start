# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/reports/e2e/
/reports/e2e-html/
/reports/qa/
/test-results/
.env.e2e

# native shells: the projects are committed, their build output is not
/ios/App/App/public
/ios/App/Pods
/ios/App/build
/android/app/build
/android/build
/android/.gradle
/android/app/src/main/assets/public
/android/local.properties

# database restore points - client data, never committed
/backups
